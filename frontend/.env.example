# Frontend .env.example
# Copier vers .env.local et renseigner vos valeurs.
# Ce fichier est un MODELE : il est versionné, n'y mettez jamais de vraie clé.

# --- Supabase ----------------------------------------------------------
# Ces deux valeurs sont publiques par conception : tout ce qui est
# NEXT_PUBLIC_ finit dans le bundle du navigateur.
# La protection vient de la Row Level Security, pas du secret.
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=collez-ici-la-cle-anon-publishable

# --- Backend -----------------------------------------------------------
# URL utilisée par le navigateur
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL utilisée par les Server Components (appels serveur à serveur)
API_INTERNAL_URL=http://localhost:8000/api/v1

# NE METTEZ JAMAIS la clé service_role ici : elle serait exposée
# à tous les visiteurs et donnerait accès à toute la base.
