# Backend .env.example
# Copier vers .env et renseigner vos valeurs Supabase.
# Ce fichier est un MODÈLE : il est versionné, ne mettez jamais de vraie clé ici.

# --- Base de données ---------------------------------------------------
# Supabase : Project Settings -> Database -> Connection string (mode Session)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Supabase ----------------------------------------------------------
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=collez-ici-la-cle-anon
# ATTENTION : cette clé contourne toutes les règles de sécurité.
# Elle reste sur le serveur, jamais dans le frontend ni dans Git.
SUPABASE_SERVICE_ROLE_KEY=collez-ici-la-cle-service-role

# --- QR / anti-fraude --------------------------------------------------
# Clé aléatoire de 32 caractères minimum. C'est elle qui rend les QR
# infalsifiables. Générez-la avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QR_SECRET=generez-une-cle-aleatoire-de-32-caracteres-minimum
QR_SECRET_VERSION=1

# --- Application -------------------------------------------------------
ENVIRONMENT=development
# Origines autorisées, séparées par des virgules
BACKEND_CORS_ORIGINS=http://localhost:3000
# Secret protégeant les tâches planifiées (expiration des tickets)
CRON_SECRET=generez-un-secret-pour-le-cron

# --- Tickets (valeurs par défaut suffisantes) -------------------------
# TICKET_VALIDITY_DAYS=30
# PDF_PER_PAGE=4
# SIGNED_URL_TTL_SECONDS=300
# STORAGE_BUCKET=tickets
